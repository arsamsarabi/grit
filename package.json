{
  "name": "@arsams/grit",
  "version": "0.1.0",
  "description": "An opinionated Git assistant — interactive TUI and scriptable CLI",
  "type": "module",
  "license": "MIT",
  "author": "Arsam Sarabi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arsamsarabi/grit.git"
  },
  "homepage": "https://github.com/arsamsarabi/grit#readme",
  "bugs": {
    "url": "https://github.com/arsamsarabi/grit/issues"
  },
  "bin": {
    "arsams-grit": "bin/arsams-grit"
  },
  "files": [
    "bin",
    "src",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "compile": "bun build --compile --outfile=dist/arsams-grit src/index.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "keywords": [
    "git",
    "cli",
    "tui",
    "conventional-commits",
    "github"
  ],
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "cac": "^7.0.0",
    "execa": "^9.6.1",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@changesets/cli": "^2.31.0",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
