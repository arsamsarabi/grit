{
  "name": "@arsams/grit",
  "version": "0.2.1",
  "description": "An opinionated Git assistant — interactive TUI and scriptable CLI",
  "type": "module",
  "license": "MIT",
  "author": "Arsam Sarabi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arsamsarabi/grit.git"
  },
  "homepage": "https://github.com/arsamsarabi/grit#readme",
  "bugs": {
    "url": "https://github.com/arsamsarabi/grit/issues"
  },
  "bin": {
    "arsams-grit": "bin/arsams-grit"
  },
  "files": [
    "bin",
    "src",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "compile": "bun build --compile --outfile=dist/arsams-grit src/index.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "sync:homebrew": "bun run scripts/sync-homebrew-formula.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "keywords": [
    "git",
    "cli",
    "tui",
    "conventional-commits",
    "github"
  ],
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "cac": "^7.0.0",
    "execa": "^9.6.1",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "9.39.5",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/bun": "^1.3.14",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.9.5",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.64.0"
  },
  "overrides": {
    "typescript": "5.9.3",
    "eslint": "9.39.5"
  }
}
